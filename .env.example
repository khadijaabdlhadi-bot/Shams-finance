# ============================================================
#  المنظومة المالية — مدرسة شمس الوطن
#  انسخ هذا الملف باسم .env ثم غيّر القيم.
#  لا ترفع ملف .env الحقيقي إلى أي مستودع أو بريد.
# ============================================================

# ---- قاعدة البيانات ----
DB_USER=shams
# ⚠️ غيّرها إلى كلمة مرور قوية قبل الاستخدام الفعلي
DB_PASSWORD=change-this-strong-password
DB_NAME=shams_finance

# للتشغيل بدون Docker على جهاز فيه PostgreSQL مثبّت:
# DATABASE_URL=postgresql://shams:كلمة-المرور@localhost:5432/shams_finance

# ---- الأمان ----
# ⚠️ غيّرها إلى نص عشوائي طويل. لتوليدها:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
TOKEN_HOURS=12
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=6
LOGIN_LOCK_MINUTES=10

# كلمة مرور حساب المدير الأول (تُستخدم مرة واحدة عند أول تشغيل فقط)
ADMIN_PASSWORD=Admin@2026

# ---- التشغيل ----
PORT=8080
HOST=0.0.0.0
TZ=Africa/Tripoli

# ---- النسخ الاحتياطي ----
AUTO_BACKUP=daily          # off | daily | weekly
AUTO_BACKUP_HOUR=2         # الساعة (0–23) بتوقيت الخادم
BACKUP_KEEP=14             # عدد النسخ المحتفظ بها

# مجلد البيانات (النسخ الاحتياطية والملفات المرفوعة). داخل Docker: /data
# DATA_DIR=./data

# مسار أدوات PostgreSQL إن لم تكن ضمن PATH (Windows مثلًا):
# PG_BIN=C:\Program Files\PostgreSQL\16\bin

# مسار Chromium لتحويل الإيصالات إلى PDF (اختياري — الطباعة تعمل بدونه):
# CHROMIUM_PATH=/usr/bin/chromium
